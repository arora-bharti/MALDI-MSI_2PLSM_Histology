# Data files (large)
*.tif
*.tiff
*.png

# ...but always keep the small example files shipped in sample_data/.
# Without these negations git silently ignores anything dropped into sample_data/
# and `git add` reports no error, so the examples never actually reach the repo.
!sample_data/README.md
!sample_data/*.tif
!sample_data/*.tiff
!sample_data/*.png
!sample_data/**/*.tif
!sample_data/**/*.tiff
!sample_data/**/*.png

# Output directories
output_data/
results/
merged/

# TensorFlow
*.h5
*.keras

# Logs
*.log
